# A private Postgres database with all StudyVault migrations is required outside tests.
DATABASE_URL=postgresql://user:password@localhost:5432/studyvault
PORT=4100
REALTIME_ALLOWED_ORIGIN=http://localhost:3000
REALTIME_JWT_DEV_MODE=false
REALTIME_JWT_JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
REALTIME_JWT_ISSUER=https://your-clerk-domain
REALTIME_JWT_AUTHORIZED_PARTIES=http://localhost:3000

# Typed, bounded admission settings. No gameplay state is stored in Upstash.
REALTIME_EVENT_LIMIT_PER_MINUTE=120
REALTIME_EVENT_MAX_PAYLOAD_BYTES=16384
REALTIME_MAX_CONNECTIONS_PER_USER=3
REALTIME_MAX_IN_FLIGHT_PER_USER=2
REALTIME_QUESTION_MS=30000
REALTIME_MAX_QUEUE=100
REALTIME_MAX_DUELS_PER_USER=20
