{
  "name": "@studyvault/game-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude dist/**"
  },
  "dependencies": {
    "@studyvault/types": "workspace:^",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
