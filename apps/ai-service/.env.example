# apps/ai-service environment. Copy to .env. All REQUIRED_ vars fail fast at startup.
# --- Required ---
AI_SERVICE_DATABASE_URL=postgresql://user:pass@localhost:5432/studyvault
AI_SERVICE_JWT_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
AI_SERVICE_JWT_ISSUER=https://<your-clerk-frontend-api>   # `iss` claim to validate (optional but recommended)
AI_SERVICE_JWT_AUTHORIZED_PARTIES=                       # comma-separated allowed `azp` origins; empty = skip
AI_SERVICE_JWT_DEV_MODE=true                             # false in any deployed env: enforces real signature checks
AI_SERVICE_LLM_PROVIDER_ORDER=logfare,groq

# --- Per-provider LLM config (keys are optional per provider; failing providers are skipped) ---
AI_SERVICE_LLM_LOGFARE_BASE_URL=https://logfare.ai/v1
AI_SERVICE_LLM_LOGFARE_MODELS=deepseek-v4-flash,deepseek-v4-pro,glm-5.2,kimi-k2.6,kimi-k2.7-code,kimi-k3,kiro-auto,minimax-m3,qwen-3.6-35b-a3b,qwen-3.8-max,glm-5.3,glm-5.3-flash,qwen-3.8-27b,deepseek-v4.1-flash-1017,economy/deepseek-v4.1-flash,gemma-4-26b,gemma-4-31b-it
AI_SERVICE_LLM_LOGFARE_API_KEY=
AI_SERVICE_LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_SERVICE_LLM_GROQ_MODEL=llama-3.1-8b-instant
AI_SERVICE_LLM_GROQ_API_KEY=

# --- Limits (config over hard-coding) ---
AI_SERVICE_MAX_UPLOAD_MB=20
AI_SERVICE_MAX_PAGES=300
AI_SERVICE_LLM_TIMEOUT_SECONDS=30
AI_SERVICE_LLM_MAX_RETRIES=2
AI_SERVICE_CIRCUIT_FAILURE_THRESHOLD=3
AI_SERVICE_CIRCUIT_COOLDOWN_SECONDS=300

# --- Ingest pipeline (Phase 2) ---
AI_SERVICE_WORKER_ENABLED=true            # run the background job loop in this process
AI_SERVICE_WORKER_POLL_SECONDS=1
AI_SERVICE_OCR_ENABLED=true               # needs the tesseract binary on PATH; skipped with a warning if absent
AI_SERVICE_OCR_LANG=eng                   # tesseract language(s), e.g. eng+ben
AI_SERVICE_STRUCTURE_MAX_INPUT_CHARS=24000  # page-digest budget sent to the LLM for chapter structuring
AI_SERVICE_MAX_CHAPTERS=60
AI_SERVICE_CHUNK_MAX_CHARS=1200
AI_SERVICE_CHUNK_OVERLAP_CHARS=150

# --- Optional observability ---
AI_SERVICE_SENTRY_DSN=
AI_SERVICE_LOG_LEVEL=INFO
# Browser origins that may call the API. Set the exact deployed web origin;
# wildcards are rejected at startup.
AI_SERVICE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_SERVICE_COURSE_LAB_RECEIPT_SECRET=  # 32+ random characters; match COURSE_LAB_RECEIPT_SECRET in the web app.

# --- Job store ---
# Postgres-backed jobs/documents/study state fails closed when unavailable in
# auto/postgres mode; memory mode is for local development/tests only. The
# worker claims durable jobs with FOR UPDATE SKIP LOCKED when Postgres is used.

# --- Phase 8 AI durability and bounded capacity ---
AI_SERVICE_LLM_MAX_PROVIDER_ATTEMPTS=6
AI_SERVICE_LLM_MAX_OUTPUT_TOKENS=4096
AI_SERVICE_LLM_MAX_INPUT_CHARS=64000
AI_SERVICE_LLM_CACHE_ENABLED=true
AI_SERVICE_LLM_CACHE_TTL_SECONDS=86400
AI_SERVICE_LLM_CACHE_MAX_CONTENT_CHARS=32000
AI_SERVICE_LLM_CACHE_MAX_ENTRIES_PER_USER=100
AI_SERVICE_LLM_CACHE_POLICY_VERSION=2
AI_SERVICE_LLM_USER_DAILY_TOKEN_BUDGET=2500000
AI_SERVICE_LLM_GLOBAL_DAILY_TOKEN_BUDGET=50000000
AI_SERVICE_LLM_FEATURE_DAILY_TOKEN_BUDGET=5000000
AI_SERVICE_LLM_USER_GENERATION_SLOTS=2
AI_SERVICE_LLM_GLOBAL_GENERATION_SLOTS=20
AI_SERVICE_LLM_GENERATION_LEASE_SECONDS=300
AI_SERVICE_MAX_DOCUMENTS_PER_USER=100
AI_SERVICE_MAX_SOURCE_VERSIONS_PER_USER=100
AI_SERVICE_MAX_CHUNKS_PER_DOCUMENT=5000
AI_SERVICE_MAX_FLASHCARDS_PER_DECK=2000
AI_SERVICE_MAX_EMBEDDING_BATCH=500
AI_SERVICE_MAX_PAGE_SIZE=100
AI_SERVICE_MAX_MAP_NODES=500
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=
AI_SERVICE_LLM_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
AI_SERVICE_LLM_HUGGINGFACE_MODEL=
AI_SERVICE_LLM_HUGGINGFACE_API_KEY=

AI_DAILY_LIMIT=30
AI_RATE_LIMIT_PER_MIN=30
