{
  "name": "@studyvault/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-ocr-assets.mjs && next dev --turbopack",
    "build": "node scripts/prepare-ocr-assets.mjs && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests && node --test scripts/prepare-ocr-assets.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:games": "playwright test --config e2e/game-vault-isolated.config.ts",
    "test:e2e:flashcard-studio": "node ./node_modules/@playwright/test/cli.js test --config e2e/flashcard-studio-isolated.config.ts",
    "test:e2e:offline-decks": "node ./node_modules/@playwright/test/cli.js test --config e2e/offline-deck-isolated.config.ts",
    "test:e2e:maps": "node ./node_modules/@playwright/test/cli.js test --config e2e/map-isolated.config.ts",
    "test:e2e:cover-builder": "playwright test --config e2e/cover-builder-isolated.config.ts",
    "test:e2e:bibliography": "playwright test --config e2e/bibliography-isolated.config.ts",
    "test:e2e:tracks": "node ./node_modules/@playwright/test/cli.js test --config e2e/track-plan-isolated.config.ts",
    "test:e2e:whiteboards": "playwright test --config e2e/whiteboard-isolated.config.ts",
    "test:e2e:ocr": "node scripts/prepare-ocr-assets.mjs && playwright test --config e2e/ocr-isolated.config.ts",
    "test:e2e:document-tools": "playwright test --config e2e/document-tools-isolated.config.ts",
    "test:e2e:tools-responsive": "playwright test --config e2e/tools-responsive-isolated.config.ts",
    "test:e2e:code-review": "playwright test --config e2e/code-review-isolated.config.ts",
    "test:e2e:checklists": "playwright test --config e2e/draft-checklist-isolated.config.ts"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@citation-js/plugin-ris": "0.9.0",
    "@clerk/nextjs": "^7.9.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/nextjs": "^11.0.0",
    "@studyvault/code-runner": "workspace:*",
    "@studyvault/db": "workspace:*",
    "@studyvault/game-engine": "workspace:*",
    "@studyvault/types": "workspace:*",
    "@tanstack/react-query": "^5.60.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "katex": "^0.19.1",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.5.438",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "tldraw": "^5.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.3.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
