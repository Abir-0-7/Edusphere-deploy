# apps/web environment (task 1.6). Copy to .env.local.
# Required — app fails fast at startup if missing (typed schema in src/env.ts).
DATABASE_URL=postgresql://user:pass@localhost:5432/studyvault
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_STUDYVAULT_EXTENSION_ID=   # 32-character ID shown in chrome://extensions for the unpacked extension
CLERK_WEBHOOK_SIGNING_SECRET=   # svix signing secret from Clerk dashboard -> Webhooks
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_SERVICE_URL=http://localhost:8000
# Public browser target. Must exactly match the AI service CORS origin setup.
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_INTERNAL_TOKEN=
JUDGE0_BASE_URL=https://judge0.example.invalid
JUDGE0_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# AI usage limits (task 1.11; config over hard-coding)
AI_DAILY_LIMIT=30
AI_RATE_LIMIT_PER_MIN=30
